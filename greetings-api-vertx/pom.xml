<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.orgkeep.demo</groupId>
    <artifactId>greetings-api-vertx</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>greetings-api-vertx</name>
    <description>An API of a realm owner protected by Orgkeep, in Vert.x: full tokens (JWT) or lightweight tokens (introspection)</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <vertx.version>5.2.1</vertx.version>
        <main.class>io.orgkeep.demo.greetings.GreetingsApi</main.class>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- the versions of every Vert.x module -->
            <dependency>
                <groupId>io.vertx</groupId>
                <artifactId>vertx-stack-depchain</artifactId>
                <version>${vertx.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
        </dependency>
        <!-- OAuth2 / OpenID Connect: JWT verified with the keys of Keycloak, or introspection (RFC 7662) -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-auth-oauth2</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mvn compile exec:java: runs the main class, without packaging -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
